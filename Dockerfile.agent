FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    ADK_DISABLE_LOCAL_STORAGE=1

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY commonsgate_agent ./commonsgate_agent
RUN pip install --no-cache-dir .

USER 65532:65532
EXPOSE 8080
CMD ["sh", "-c", "exec adk api_server --host 0.0.0.0 --port ${PORT} --no-reload --a2a --session_service_uri=memory:// --artifact_service_uri=memory:// commonsgate_agent"]

