# Local development uses the deterministic normalizer. Set to gemini for the
# hackathon-eligible path after configuring Gemini API or Vertex AI credentials.
COMMONSGATE_ENV=development
COMMONSGATE_NORMALIZER=rule
COMMONSGATE_TRANSLATOR=template
COMMONSGATE_REPOSITORY=memory
COMMONSGATE_FIRESTORE_PREFIX=commonsgate
COMMONSGATE_GEMINI_MODEL=gemini-3.5-flash
COMMONSGATE_ADK_MODEL=gemini-3.5-flash
COMMONSGATE_PUBLIC_BASE_URL=http://localhost:8080
COMMONSGATE_API_URL=http://localhost:8080
COMMONSGATE_ENABLE_CLOUD_TRACE=false

# Generate unique values; never reuse these development placeholders in a deployment.
COMMONSGATE_DELEGATION_SECRET=replace-with-at-least-32-random-characters
COMMONSGATE_ADMIN_KEY=replace-with-a-random-admin-key

# Synthetic single-principal ADK demo credentials. Obtain the delegation token
# from POST /v1/demo/delegations after creating and opening the demo round.
COMMONSGATE_DEMO_AGENT_ID=demo-free-agent
COMMONSGATE_DEMO_PRINCIPAL_TOKEN=synthetic-principal-token-0001
COMMONSGATE_DEMO_DELEGATION_TOKEN=
# Held by the steward adapter, never exposed as an LLM tool argument.
COMMONSGATE_DEMO_ROUND_SEED=replace-with-the-seed-used-for-the-round-commitment

# Option A: Gemini API (local only)
GEMINI_API_KEY=

# Option B: Vertex AI / Google Cloud
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-east1
