{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonsgate.dev/schemas/fair-access-envelope/1.0.0",
  "title": "Fair Access Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "provider_id",
    "program_id",
    "round_id",
    "principal_token",
    "delegate",
    "policy_facts",
    "field_provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "envelope_id": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "program_id": { "type": "string", "minLength": 1 },
    "round_id": { "type": "string", "minLength": 1 },
    "principal_token": {
      "type": "string",
      "minLength": 16,
      "description": "Program-scoped pseudonymous token; never a universal identifier."
    },
    "delegate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "delegation_id", "scopes"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "delegation_id": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["submit", "read_status", "correct", "withdraw", "appeal"] }
        }
      }
    },
    "policy_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_area_confirmed", "priority_tier", "accommodation_requested"],
      "properties": {
        "service_area_confirmed": { "type": "boolean" },
        "priority_tier": { "type": "integer", "minimum": 1 },
        "accommodation_requested": { "type": "boolean" }
      }
    },
    "field_provenance": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/provenance" }
    },
    "communication_preferences": {
      "type": "object",
      "additionalProperties": false,
      "description": "Delivery preferences only. This object is excluded from policy_facts and allocation.",
      "properties": {
        "response_language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
          "description": "BCP 47 language tag for receipts and explanations."
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "type", "content_hash"],
        "properties": {
          "evidence_id": { "type": "string" },
          "type": { "type": "string" },
          "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "storage_reference": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "method", "confidence", "human_verified"],
      "properties": {
        "source": { "type": "string" },
        "method": { "enum": ["structured_submission", "gemini_extraction", "human_correction", "rule_fallback"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "human_verified": { "type": "boolean" }
      }
    }
  }
}
