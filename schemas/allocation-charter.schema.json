{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonsgate.dev/schemas/allocation-charter/1.0.0",
  "title": "CommonsGate Allocation Charter",
  "type": "object",
  "additionalProperties": false,
  "required": ["charter_id", "version", "capacity", "reservations", "tie_break"],
  "properties": {
    "charter_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "capacity": { "type": "integer", "minimum": 0 },
    "reservations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accommodation_capacity", "release_unused"],
      "properties": {
        "accommodation_capacity": { "type": "integer", "minimum": 0 },
        "release_unused": { "type": "boolean" }
      }
    },
    "tie_break": { "const": "committed_deterministic_random" }
  }
}

